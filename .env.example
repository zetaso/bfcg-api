PORT=3000
SUPABASE_URL=https://supabase_project_id.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_key

# Browser origins allowed to call the API (comma separated). Admin writes from any other origin are refused.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin session cookies. Defaults: secure, SameSite=Lax.
# COOKIE_SAMESITE=none only if the frontend and API end up on unrelated domains.
# COOKIE_SECURE=false only for local development in Safari over http.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Set to 1 when running behind a hosting proxy, so login rate limiting sees real client IPs.
# TRUST_PROXY=1
